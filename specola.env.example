# Copy to specola.env (gitignored, chmod 600) and fill in real values.

# Postgres DSN. Point at your database host/service.
SPECOLA_DATABASE_URL=postgres://specola:CHANGEME@postgres:5432/specola?sslmode=disable

# Public origin where Specola is reachable.
SPECOLA_BASE_URL=https://specola.example.com

# Random >=32 bytes, signs the session cookie. Generate with:
#   openssl rand -base64 48
SPECOLA_SESSION_SECRET=CHANGEME

# OIDC (Logto or any compliant provider). The old SPECOLA_LOGTO_ENDPOINT /
# _APP_ID / _APP_SECRET names still work as aliases.
SPECOLA_OIDC_ISSUER=https://auth.example.com/oidc
SPECOLA_OIDC_CLIENT_ID=CHANGEME
SPECOLA_OIDC_CLIENT_SECRET=CHANGEME

# Optional. Audience required on MCP access tokens. Default <base>/mcp
# SPECOLA_MCP_RESOURCE=https://specola.example.com/mcp

# Optional: serve rendered pages from a separate hostname that also reaches
# this server, for defense in depth. Requires SPECOLA_SESSION_SECRET.
# SPECOLA_VIEW_ORIGIN=https://view.example.com

# Local dev only: bypass OIDC and treat every request as this user.
# Leave empty in production.
# SPECOLA_DEV_AUTH_EMAIL=you@example.com

# Optional. Default :8080
# SPECOLA_LISTEN=:8080

# Optional: page backends (server code shipped in SPA bundles, run by the
# runner service, see docs/page-backends.md and runner/README.md). Unset =
# backends disabled. Set all three or none: specola refuses to start with
# only some of them.
# SPECOLA_RUNNER_URL=http://runner:8081
# Shared with the runner, which needs the same value. Generate with:
#   openssl rand -base64 32
# SPECOLA_RUNNER_TOKEN=CHANGEME
# 32 random bytes, base64; encrypts page secrets. Generate with:
#   openssl rand -base64 32
# Keep it: losing it makes stored page secrets unreadable.
# SPECOLA_SECRETS_KEY=CHANGEME
# Optional, with the runner: delete the backend data (and its snapshots) of
# pages dormant this many days: archived, or whose current version has no
# backend. Unset = never.
# SPECOLA_BACKEND_PURGE_AFTER_DAYS=180
# Optional, with the runner, behind a reverse proxy that sets
# X-Forwarded-For: rate-limit public links' backend calls (and new visitors) per client (the
# first X-Forwarded-For hop) rather than per proxy. Leave unset when clients
# reach specola directly: they could then choose their own IP.
# SPECOLA_TRUST_FORWARDED=1
# Optional: how many anonymous visitors a public link keeps data for (their
# localStorage, and their own backend database). Default 1000.
# SPECOLA_PUBLIC_VISITORS_PER_LINK=1000
# (SPECOLA_TEST_CRON_EVERY and SPECOLA_TEST_CLOCK_OFFSET exist for the
# end-to-end tests only; never set them here.)
