# Copy to specola.env (gitignored, chmod 600) and fill in real values.

# Postgres DSN. Point at your database host/service.
SPECOLA_DATABASE_URL=postgres://specola:CHANGEME@postgres:5432/specola?sslmode=disable

# Public origin where Specola is reachable.
SPECOLA_BASE_URL=https://specola.example.com

# Random >=32 bytes, signs the session cookie. Generate with:
#   openssl rand -base64 48
SPECOLA_SESSION_SECRET=CHANGEME

# OIDC (Logto or any compliant provider). The old SPECOLA_LOGTO_ENDPOINT /
# _APP_ID / _APP_SECRET names still work as aliases.
SPECOLA_OIDC_ISSUER=https://auth.example.com/oidc
SPECOLA_OIDC_CLIENT_ID=CHANGEME
SPECOLA_OIDC_CLIENT_SECRET=CHANGEME

# Optional. Audience required on MCP access tokens. Default <base>/mcp
# SPECOLA_MCP_RESOURCE=https://specola.example.com/mcp

# Local dev only: bypass OIDC and treat every request as this user.
# Leave empty in production.
# SPECOLA_DEV_AUTH_EMAIL=you@example.com

# Optional. Default :8080
# SPECOLA_LISTEN=:8080
