{
  "name": "@specola/vite-plugin",
  "version": "1.1.0",
  "description": "Build a Vite app (and its page backend) as a Specola bundle and publish it with specola-publish",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./server": {
      "types": "./server.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "bin": {
    "specola-publish": "bin/specola-publish.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.d.ts",
    "server.d.ts",
    "lib/",
    "bin/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
